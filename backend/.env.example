# Copy this file to ".env" and fill in your own values.

# Port this backend listens on (the frontend calls http://localhost:5000).
PORT=5000

# MySQL connection (the database created by transithub_ju.sql).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=transithub_ju

# MUST be exactly the same JWT_SECRET as the login backend
# (feature/registration-login, backend/src/features/auth/.env),
# otherwise the login token will be rejected here.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Where the React app runs (allowed by CORS).
FRONTEND_ORIGIN=http://localhost:5173
