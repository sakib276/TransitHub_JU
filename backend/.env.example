# Copy this file to ".env" and fill in your own values.

# Port this backend listens on (the frontend calls http://localhost:5000).
PORT=5000

# MySQL connection (the database created by transithub_ju.sql).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=transithub_ju

# Secret used to sign and check login tokens (at least 32 characters).
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Code someone must type to register as an Admin.
ADMIN_REGISTRATION_CODE=replace-with-a-private-admin-enrollment-code

# Where the React app runs (allowed by CORS).
FRONTEND_ORIGIN=http://localhost:5173

# Optional: only needed for Driver OTP login and password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TransitHub JU <no-reply@example.com>
